module main

struct Counter { u64 value; }

fn pair(Counter counter): (int, int) {
  counter.value = counter.value + 1;
  return 1 + 2, 3 * 4;
}

fn forward(Counter counter): (int, int) {
  return pair(counter);
}

fn six(): (int, int, int, int, int, int) {
  return 1, 2, 3, 4, 5, 6;
}

internal fn main(): int {
  Counter counter = { .value = 0 };
  var a, b = forward(counter);
  if (counter.value != 1) {
    return 99;
  }
  var x1, x2, x3, x4, x5, x6 = six();
  if (x1 + x6 != 7) {
    return 98;
  }
  return a + b;
}
